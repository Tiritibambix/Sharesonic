<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive-icon background layer: full-bleed violet to blue diagonal
    gradient (#7c3aed → #2563eb across the visible 72dp viewport) with a soft
    white highlight in the upper left. The system masks this into whatever
    shape the launcher needs, so it covers the entire 108x108 canvas.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="18"
                android:startY="18"
                android:endX="90"
                android:endY="90"
                android:startColor="#7C3AED"
                android:endColor="#2563EB"/>
        </aapt:attr>
    </path>

    <!-- Highlight -->
    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="40"
                android:centerY="30"
                android:gradientRadius="46"
                android:startColor="#2EFFFFFF"
                android:endColor="#00FFFFFF"/>
        </aapt:attr>
    </path>

</vector>
